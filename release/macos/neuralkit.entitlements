<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Every entitlement claimed here must be authorized by the embedded provisioning
	     profile, or AMFI kills the process at launch (measured: exit 137 — see
	     phaze-auth/src/enclave.rs header). Both profiles ("Neuralkit CLI Dev" and
	     "Neuralkit CLI Developer ID") grant each of them; verified by decoding the files
	     with `security cms -D -i`. -->
	<key>com.apple.application-identifier</key>
	<string>SBG7YFF24U.ai.neuralkit.cli</string>
	<key>com.apple.developer.team-identifier</key>
	<string>SBG7YFF24U</string>
	<!-- The one that matters: what lets a persisted Secure Enclave key carry an access
	     control (Watch / Touch ID / PIN). Team-prefixed, and it must match the App ID —
	     a bare `ai.neuralkit.cli` here is the -34018 trap. -->
	<key>keychain-access-groups</key>
	<array>
		<string>SBG7YFF24U.ai.neuralkit.cli</string>
	</array>
	<!-- The account's passkey through the system sheet (`login::system_approve`): the domain whose
	     credentials this app may ask the OS for. The association file on neuralkit.ai names
	     SBG7YFF24U.ai.neuralkit.cli under `webcredentials`; without this claim the sheet is refused
	     with code 1004 and the menu row opens the browser instead. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>webcredentials:neuralkit.ai</string>
	</array>
</dict>
</plist>
