<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- `phaze native bundle` stamps the rest: the identifier and both names from the app's
	     `native({ name, fileName, identifier })` — the identifier must equal the App ID's bundle id,
	     since the provisioning profile's application-identifier (SBG7YFF24U.ai.neuralkit.cli) is
	     matched against TEAMID + it at launch — the executable from the crate, the version from
	     Cargo.toml, and the localized name Finder shows. -->
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<!-- A terminal tool wearing an .app: never in the Dock, never in Force Quit. -->
	<key>LSUIElement</key>
	<true/>
	<key>LSMinimumSystemVersion</key>
	<string>26.0</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Neuralkit finds, pairs and reads your EEG headset over Bluetooth.</string>
</dict>
</plist>
